PORT=3001
HOST=0.0.0.0
NODE_ENV=production
SHUTDOWN_TIMEOUT_MS=10000
JSON_BODY_LIMIT=8mb
# Kommagetrennte Browser-/Flutter-Web-Ursprünge; native Apps senden keinen Origin.
JWT_SECRET=replace-with-at-least-32-random-characters
# Anzahl vertrauenswürdiger Reverse-Proxy-Hops, z. B. 1. Leer lassen ohne Proxy.
TRUST_PROXY=
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-one-time-password
APP_BASE_URL=https://materialkompass.org
CORS_ORIGIN=https://materialkompass.org
SMTP_HOST=mail.materialkompass.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@materialkompass.org
SMTP_PASSWORD=replace-me
MAIL_FROM=MaterialKompass <noreply@materialkompass.org>
# Domain für von Administratoren angelegte Scanner-Adressen.
SCANNER_EMAIL_DOMAIN=materialkompass.org
# Zufälliges internes Geheimnis (mindestens 32 Zeichen), z. B. mit:
# openssl rand -hex 32
MAILBOX_PROVISIONER_TOKEN=replace-with-at-least-32-random-characters
# Separater Schlüssel für abrufbare Scanner-Passwörter. Nicht nachträglich ändern:
# openssl rand -hex 32
MAILBOX_PASSWORD_ENCRYPTION_KEY=replace-with-a-64-character-hex-value
MAILSERVER_CONTAINER=mailserver
MAILBOX_SERVER_HOST=mail.materialkompass.org
# Eigenes Postfach für Mängelmeldungen. Die Zugangsdaten dürfen nicht mit dem
# Scanner- oder Account-Postfach geteilt werden.
DEFECT_IMAP_HOST=mail.materialkompass.org
DEFECT_IMAP_PORT=993
DEFECT_IMAP_SECURE=true
DEFECT_IMAP_USER=maengel@materialkompass.org
DEFECT_IMAP_PASSWORD=replace-me
DEFECT_IMAP_MAILBOX=INBOX
DEFECT_IMAP_PROCESSED_MAILBOX=Verarbeitet
DEFECT_IMAP_POLL_INTERVAL_MS=300000
DEFECT_IMAP_TLS_REJECT_UNAUTHORIZED=true
DB_HOST=localhost
DB_PORT=3306
DB_NAME=materialkompass
DB_USER=materialkompass
DB_PASSWORD=replace-me
DB_ROOT_PASSWORD=replace-with-a-different-strong-password
DB_VOLUME_NAME=materialkompass_db_data
DB_CONNECTION_LIMIT=5
DB_SSL=false
# Alternativ zu den Standardpfaden /app/downloads/... konfigurierbar.
DOWNLOAD_WINDOWS_PATH=/app/downloads/MaterialKompass-Windows.exe
DOWNLOAD_LINUX_PATH=/app/downloads/MaterialKompass-Linux.deb
DOWNLOAD_ANDROID_PATH=/app/downloads/MaterialKompass-Android.apk
CLIENT_WINDOWS_VERSION=1.0.0
CLIENT_LINUX_VERSION=1.0.0
CLIENT_ANDROID_VERSION=1.0.0
CLIENT_WINDOWS_MIN_VERSION=1.0.0
CLIENT_LINUX_MIN_VERSION=1.0.0
CLIENT_ANDROID_MIN_VERSION=1.0.0
CLIENT_UPDATE_NOTES=
