PORT=3001
HOST=0.0.0.0
NODE_ENV=production
SHUTDOWN_TIMEOUT_MS=10000
JSON_BODY_LIMIT=8mb
# Kommagetrennte Browser-/Flutter-Web-Ursprünge; native Apps senden keinen Origin.
JWT_SECRET=replace-with-at-least-32-random-characters
# Anzahl vertrauenswürdiger Reverse-Proxy-Hops, z. B. 1. Leer lassen ohne Proxy.
TRUST_PROXY=
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-one-time-password
APP_BASE_URL=https://materialkompass.org
CORS_ORIGIN=https://materialkompass.org
SMTP_HOST=smtp.ionos.de
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@materialkompass.org
SMTP_PASSWORD=replace-me
MAIL_FROM=MaterialKompass <noreply@materialkompass.org>
DB_HOST=localhost
DB_PORT=3306
DB_NAME=materialkompass
DB_USER=materialkompass
DB_PASSWORD=replace-me
DB_ROOT_PASSWORD=replace-with-a-different-strong-password
DB_VOLUME_NAME=materialkompass_db_data
DB_CONNECTION_LIMIT=5
DB_SSL=false
# Alternativ zu den Standardpfaden /app/downloads/... konfigurierbar.
DOWNLOAD_WINDOWS_PATH=/app/downloads/MaterialKompass-Windows.zip
DOWNLOAD_LINUX_PATH=/app/downloads/MaterialKompass-Linux.tar.gz
DOWNLOAD_ANDROID_PATH=/app/downloads/MaterialKompass-Android.apk
CLIENT_WINDOWS_VERSION=1.0.0
CLIENT_LINUX_VERSION=1.0.0
CLIENT_ANDROID_VERSION=1.0.0
CLIENT_WINDOWS_MIN_VERSION=1.0.0
CLIENT_LINUX_MIN_VERSION=1.0.0
CLIENT_ANDROID_MIN_VERSION=1.0.0
CLIENT_UPDATE_NOTES=
