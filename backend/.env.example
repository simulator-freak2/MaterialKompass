PORT=3001
HOST=0.0.0.0
NODE_ENV=production
SHUTDOWN_TIMEOUT_MS=10000
JSON_BODY_LIMIT=8mb
# Kommagetrennte Browser-/Flutter-Web-Ursprünge; native Apps senden keinen Origin.
JWT_SECRET=replace-with-at-least-32-random-characters
# TLS wird am lokalen Reverse-Proxy terminiert; nur dessen Forwarded-Header vertrauen.
TRUST_PROXY=loopback
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-one-time-password
APP_BASE_URL=https://materialkompass.org
CORS_ORIGIN=https://materialkompass.org
SMTP_HOST=mail.materialkompass.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@materialkompass.org
SMTP_PASSWORD=replace-me
MAIL_FROM=MaterialKompass <noreply@materialkompass.org>
# Domain für von Administratoren angelegte Scanner-Adressen.
SCANNER_EMAIL_DOMAIN=materialkompass.org
# Zufälliges internes Geheimnis (mindestens 32 Zeichen), z. B. mit:
# openssl rand -hex 32
MAILBOX_PROVISIONER_TOKEN=replace-with-at-least-32-random-characters
# Compose setzt den privaten Unix-Socket selbst. Für getrennte Hosts nur HTTPS verwenden.
MAILBOX_PROVISIONER_SOCKET=/run/materialkompass/mailbox-provisioner.sock
# Separater Schlüssel für abrufbare Scanner-Passwörter. Nicht nachträglich ändern:
# openssl rand -hex 32
MAILBOX_PASSWORD_ENCRYPTION_KEY=replace-with-a-64-character-hex-value
MAILSERVER_CONTAINER=mailserver
MAILBOX_SERVER_HOST=mail.materialkompass.org
# Eigenes Postfach für Mängelmeldungen. Die Zugangsdaten dürfen nicht mit dem
# Scanner- oder Account-Postfach geteilt werden.
DEFECT_IMAP_HOST=mail.materialkompass.org
DEFECT_IMAP_PORT=993
DEFECT_IMAP_SECURE=true
DEFECT_IMAP_USER=maengel@materialkompass.org
DEFECT_IMAP_PASSWORD=replace-me
DEFECT_IMAP_MAILBOX=INBOX
DEFECT_IMAP_PROCESSED_MAILBOX=Verarbeitet
DEFECT_IMAP_POLL_INTERVAL_MS=300000
DEFECT_IMAP_TLS_REJECT_UNAUTHORIZED=true
# Eigenes Postfach für eingescannte Inventurlisten. Der Betreff oder Dateiname
# muss die Inventur-ID (z. B. stocktake-12) oder die eindeutige Bezeichnung enthalten.
INVENTORY_IMAP_HOST=mail.materialkompass.org
INVENTORY_IMAP_PORT=993
INVENTORY_IMAP_SECURE=true
INVENTORY_IMAP_USER=inventur@materialkompass.org
INVENTORY_IMAP_PASSWORD=replace-me
INVENTORY_IMAP_MAILBOX=INBOX
INVENTORY_IMAP_PROCESSED_MAILBOX=Verarbeitet
INVENTORY_IMAP_POLL_INTERVAL_MS=300000
INVENTORY_IMAP_TLS_REJECT_UNAUTHORIZED=true
DB_HOST=localhost
DB_PORT=3306
DB_NAME=materialkompass
DB_USER=materialkompass
DB_PASSWORD=replace-me
DB_ROOT_PASSWORD=replace-with-a-different-strong-password
DB_VOLUME_NAME=materialkompass_db_data
DB_CONNECTION_LIMIT=5
DB_SSL=false
# Alternativ zu den Standardpfaden /app/downloads/... konfigurierbar.
DOWNLOAD_WINDOWS_PATH=/app/downloads/MaterialKompass-Windows.exe
DOWNLOAD_LINUX_PATH=/app/downloads/MaterialKompass-Linux.deb
DOWNLOAD_ANDROID_PATH=/app/downloads/MaterialKompass-Android.apk
DOWNLOAD_IOS_PATH=/app/downloads/MaterialKompass-iOS.ipa
DOWNLOAD_MACOS_PATH=/app/downloads/MaterialKompass-macOS.dmg
CLIENT_WINDOWS_VERSION=1.0.0
CLIENT_LINUX_VERSION=1.0.0
CLIENT_ANDROID_VERSION=1.0.0
CLIENT_WINDOWS_MIN_VERSION=1.0.0
CLIENT_LINUX_MIN_VERSION=1.0.0
CLIENT_ANDROID_MIN_VERSION=1.0.0
CLIENT_UPDATE_NOTES=

# Rechtliche Pflichtangaben. Die Beispielwerte sind Dummies und müssen vor
# Produktivbetrieb anhand der tatsächlichen Betreiberstruktur ersetzt werden.
LEGAL_CONTROLLER_NAME=[DUMMY – Musterorganisation]
LEGAL_LEGAL_FORM=[DUMMY – e. V.]
LEGAL_REPRESENTED_BY=[DUMMY – Max Mustermann, Vorstand]
LEGAL_STREET=[DUMMY – Musterstraße 1]
LEGAL_POSTAL_CODE=[DUMMY – 12345]
LEGAL_CITY=[DUMMY – Musterstadt]
LEGAL_COUNTRY=Deutschland
LEGAL_EMAIL=[DUMMY – datenschutz@example.org]
LEGAL_PHONE=[DUMMY – +49 000 000000]
LEGAL_REGISTER=[DUMMY – Vereinsregister Amtsgericht Musterstadt]
LEGAL_REGISTER_NUMBER=[DUMMY – VR 0000]
LEGAL_VAT_ID=[DUMMY – nicht vorhanden / DE000000000]
LEGAL_DPO_NAME=[DUMMY – Datenschutzkoordination]
LEGAL_DPO_EMAIL=[DUMMY – datenschutz@example.org]
LEGAL_DPO_ADDRESS=[DUMMY – Anschrift wie Verantwortlicher]
LEGAL_SUPERVISORY_AUTHORITY=[DUMMY – zuständige Landesdatenschutzaufsicht]
LEGAL_SUPERVISORY_ADDRESS=[DUMMY – Anschrift der Aufsichtsbehörde]
LEGAL_SUPERVISORY_WEBSITE=[DUMMY – https://www.datenschutzaufsicht.example]
LEGAL_ACCOUNT_BASIS=[DUMMY – z. B. Art. 6 Abs. 1 lit. b, e oder f DSGVO]
LEGAL_OPERATIONS_BASIS=[DUMMY – konkrete Rechtsgrundlage je Betreiber und Zweck]
LEGAL_LEGITIMATE_INTERESTS=[DUMMY – konkrete Interessen oder nicht anwendbar]

# Technische Standardfristen in Tagen. Fach- und Belegdaten werden nach dem
# organisationsspezifischen Löschkonzept behandelt.
RETENTION_AUDIT_DAYS=1095
RETENTION_EXPORT_LOG_DAYS=365
RETENTION_NOTIFICATION_DAYS=365
RETENTION_EXPIRED_QR_DAYS=30
