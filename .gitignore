# Dart and Flutter generated files
.dart_tool/
build/
**/.dart_tool/
**/build/
**/bin/
**/obj/
.flutter-plugins
.flutter-plugins-dependencies

# Node.js dependencies and logs
**/node_modules/
npm-debug.log*

# Runtime configuration and secrets
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Editors and operating systems
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# Local logs and temporary files
*.log
*.tmp
*.bak
tmp/
.dart-appdata/
.dart-localappdata/
*.tar.gz

# Lokale bzw. produktive Datenbanksicherungen
backups/
.deployments/
/web-current/

# Desktop-Releases werden separat gebaut und nicht in Git eingecheckt.
releases/*
!releases/.gitkeep
releases-*/

# Firebase-/Push-Zugangsdaten bleiben ausschließlich auf dem Zielsystem.
secrets/*
!secrets/.gitkeep
